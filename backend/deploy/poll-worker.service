# systemd unit for the persistent poller (backend/scripts/poll-worker.ts).
# See README.md ("The open-seat poller") for the full setup walkthrough.
#
# Install:
#   sudo cp backend/deploy/poll-worker.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now poll-worker
# Check on it:
#   sudo systemctl status poll-worker
#   sudo journalctl -u poll-worker -f
#
# Before installing, edit the two paths below to match where you cloned the
# repo and the real user you're running as (`whoami`) — systemd doesn't
# expand `~` or `$HOME`.

[Unit]
Description=RUAB Sniper open-seat poll worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=YOUR_USERNAME
WorkingDirectory=/home/YOUR_USERNAME/RUABSniper/backend
ExecStart=/usr/bin/npm run poll-worker
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
