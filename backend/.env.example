# Copy to .env for local runs. In CI these are set as GitHub Actions
# repository secrets (see .github/workflows/*.yml) — never commit a real .env.

# Project Settings > API in your Supabase dashboard.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The service_role key (NOT the anon key) — bypasses RLS so these scripts
# can write to courses/sections/professor_rmp_matches. Keep it out of the
# web app entirely.
SUPABASE_SERVICE_ROLE_KEY=

# Web Push credentials — a self-generated VAPID keypair, no account signup
# needed. Generate once with `npx web-push generate-vapid-keys` and paste the
# two halves in here; put the public half in web/.env as
# VITE_VAPID_PUBLIC_KEY too (see web/.env.example). VAPID_SUBJECT must be a
# "mailto:you@example.com" address (required by the Web Push spec, used by
# push services to contact you if something's wrong with your traffic — it's
# never shown to users).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
