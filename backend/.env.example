# Copy to .env for local runs. In CI these are set as GitHub Actions
# repository secrets (see .github/workflows/*.yml) — never commit a real .env.

# Project Settings > API in your Supabase dashboard.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The service_role key (NOT the anon key) — bypasses RLS so these scripts
# can write to courses/sections/professor_rmp_matches. Keep it out of the
# mobile app entirely.
SUPABASE_SERVICE_ROLE_KEY=

# Free Resend account (resend.com, no card needed) — used instead of real
# APNs push, which requires a paid Apple Developer Program membership.
# Without a verified domain, Resend's free tier can only send to the email
# address your account is registered under, so NOTIFY_EMAIL_TO must be that
# same address.
RESEND_API_KEY=
NOTIFY_EMAIL_TO=
