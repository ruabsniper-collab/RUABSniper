# Copy to .env (Expo loads EXPO_PUBLIC_* vars automatically and inlines
# them at build time — never put a secret behind this prefix).
# Project Settings > API in your Supabase dashboard.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Free key (no card required, 25k requests/month) from
# https://ocr.space/ocrapi/freekey — powers "Import from screenshot" on the
# My Schedule tab. Leave blank and that one feature just shows an error;
# everything else in the app works without it.
EXPO_PUBLIC_OCR_SPACE_API_KEY=
